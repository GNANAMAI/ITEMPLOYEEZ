# Database
DATABASE_URL=sqlite:///./itemployeez.db

# JWT Authentication
JWT_SECRET=change-this-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google OAuth (optional — leave empty to disable Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Razorpay (use test keys from Razorpay dashboard)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_MONTHLY=plan_monthly_id
RAZORPAY_PLAN_YEARLY=plan_yearly_id

# Sub-admin default credentials (change after first login)
SUBADMIN_EMAIL=admin@itemployeez.com
SUBADMIN_PASSWORD=Admin@12345

# App
APP_NAME=IT Employeez
DEBUG=true
